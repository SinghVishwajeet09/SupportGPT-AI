# Runtime
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
API_PORT=4000

# PostgreSQL
POSTGRES_DB=supportgpt
POSTGRES_USER=supportgpt
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://supportgpt:change_me_for_local_development@localhost:5433/supportgpt?schema=public

# Redis / Qdrant
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=supportgpt_knowledge

# AI (select the embedding implementation through EMBEDDING_PROVIDER)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
AI_MAX_OUTPUT_TOKENS=1024

# Auth: replace all example values before use outside local development
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_at_least_32_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Uploads
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Email and automation
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SupportGPT AI <no-reply@example.com>
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_for_local_development
N8N_ENCRYPTION_KEY=replace_with_a_32_character_secret
